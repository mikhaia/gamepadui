{
  "$schema": "https://raw.githubusercontent.com/neutralinojs/neutralinojs/main/schemas/neutralino.config.schema.json",
  "applicationId": "ui.gamepad.launcher",
  "version": "0.1.0",
  "defaultMode": "window",
  "port": 0,
  "documentRoot": "/resources/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "one-time",
  "logging": {
    "enabled": true,
    "writeToLogFile": false
  },
  "nativeAllowList": [
    "app.exit",
    "window.*",
    "os.getPath",
    "os.getEnv",
    "os.showOpenDialog",
    "os.showFolderDialog",
    "os.execCommand",
    "os.spawnProcess",
    "os.updateSpawnedProcess",
    "os.trashItem",
    "net.request",
    "storage.*",
    "filesystem.readDirectory",
    "filesystem.readBinaryFile",
    "filesystem.getJoinedPath",
    "filesystem.getPathParts",
    "filesystem.getStats",
    "filesystem.move",
    "filesystem.remove"
  ],
  "modes": {
    "window": {
      "title": "GamePad UI",
      "width": 1280,
      "height": 720,
      "minWidth": 960,
      "minHeight": 540,
      "center": true,
      "fullScreen": true,
      "alwaysOnTop": false,
      "enableInspector": true,
      "borderless": false,
      "maximize": false,
      "hidden": false,
      "resizable": true,
      "exitProcessOnClose": false
    },
    "browser": {
      "nativeBlockList": [
        "filesystem.*",
        "os.execCommand"
      ]
    }
  },
  "cli": {
    "binaryName": "gamepad-ui",
    "resourcesPath": "/resources/",
    "clientLibrary": "/resources/js/neutralino.js",
    "binaryVersion": "6.9.0",
    "clientVersion": "6.9.0"
  }
}
